# Cloud provider cutover template
# Fill ONE provider section, then apply to runtime and rerun validation.

# Common
SECRET_PROVIDER=<aws_sm|gcp_sm|azure_kv>

# Required secret keys in provider payload (or per-secret id/name mapping):
# credential_master_key
# approval_token_secret
# auth_token_secret
# admin_password
# operator_password
# viewer_password

# =====================
# AWS Secrets Manager
# =====================
# SECRET_PROVIDER=aws_sm
# SECRET_PROVIDER_AWS_REGION=us-east-1
# SECRET_PROVIDER_AWS_SECRET_ID=itops/agents/secrets
# Optional per-secret overrides:
# CREDENTIAL_MASTER_KEY_AWS_SECRET_ID=
# APPROVAL_TOKEN_SECRET_AWS_SECRET_ID=
# AUTH_TOKEN_SECRET_AWS_SECRET_ID=
# ADMIN_PASSWORD_AWS_SECRET_ID=
# OPERATOR_PASSWORD_AWS_SECRET_ID=
# VIEWER_PASSWORD_AWS_SECRET_ID=
# Optional JSON key mapping overrides:
# CREDENTIAL_MASTER_KEY_AWS_KEY=credential_master_key
# APPROVAL_TOKEN_SECRET_AWS_KEY=approval_token_secret
# AUTH_TOKEN_SECRET_AWS_KEY=auth_token_secret
# ADMIN_PASSWORD_AWS_KEY=admin_password
# OPERATOR_PASSWORD_AWS_KEY=operator_password
# VIEWER_PASSWORD_AWS_KEY=viewer_password

# =====================
# GCP Secret Manager
# =====================
# SECRET_PROVIDER=gcp_sm
# SECRET_PROVIDER_GCP_PROJECT=my-gcp-project
# SECRET_PROVIDER_GCP_SECRET_ID=itops-agents-secrets
# Optional per-secret overrides:
# CREDENTIAL_MASTER_KEY_GCP_SECRET_ID=
# APPROVAL_TOKEN_SECRET_GCP_SECRET_ID=
# AUTH_TOKEN_SECRET_GCP_SECRET_ID=
# ADMIN_PASSWORD_GCP_SECRET_ID=
# OPERATOR_PASSWORD_GCP_SECRET_ID=
# VIEWER_PASSWORD_GCP_SECRET_ID=
# Optional JSON key mapping overrides:
# CREDENTIAL_MASTER_KEY_GCP_KEY=credential_master_key
# APPROVAL_TOKEN_SECRET_GCP_KEY=approval_token_secret
# AUTH_TOKEN_SECRET_GCP_KEY=auth_token_secret
# ADMIN_PASSWORD_GCP_KEY=admin_password
# OPERATOR_PASSWORD_GCP_KEY=operator_password
# VIEWER_PASSWORD_GCP_KEY=viewer_password

# =====================
# Azure Key Vault
# =====================
# SECRET_PROVIDER=azure_kv
# SECRET_PROVIDER_AZURE_VAULT_NAME=itops-secrets-kv
# SECRET_PROVIDER_AZURE_SECRET_NAME=itops-agents-secrets
# Optional per-secret overrides:
# CREDENTIAL_MASTER_KEY_AZURE_SECRET_NAME=
# APPROVAL_TOKEN_SECRET_AZURE_SECRET_NAME=
# AUTH_TOKEN_SECRET_AZURE_SECRET_NAME=
# ADMIN_PASSWORD_AZURE_SECRET_NAME=
# OPERATOR_PASSWORD_AZURE_SECRET_NAME=
# VIEWER_PASSWORD_AZURE_SECRET_NAME=
# Optional JSON key mapping overrides:
# CREDENTIAL_MASTER_KEY_AZURE_KEY=credential_master_key
# APPROVAL_TOKEN_SECRET_AZURE_KEY=approval_token_secret
# AUTH_TOKEN_SECRET_AZURE_KEY=auth_token_secret
# ADMIN_PASSWORD_AZURE_KEY=admin_password
# OPERATOR_PASSWORD_AZURE_KEY=operator_password
# VIEWER_PASSWORD_AZURE_KEY=viewer_password

# Validation command (after applying and restarting runtime):
# scripts/run-provider-bootstrap-matrix.sh \
#   --env-file .env \
#   --providers aws_sm,gcp_sm,azure_kv \
#   --api-base http://localhost:19123 \
#   --token "$ADMIN_TOKEN" \
#   --report /tmp/provider-bootstrap-report-live.md
