{
  "name": "itops-agents",
  "version": "1.0.0",
  "description": "RightAPI Forge - self-hosted governed AI operations and internal-tool platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:factory-dashboard": "tsx src/factory-dashboard/server.ts",
    "build": "node build.mjs",
    "check:boundaries": "node tools/checkModuleBoundaries.mjs",
    "release:audit": "node tools/publicReleaseAudit.mjs",
    "release:evidence": "node tools/generateReleaseEvidence.mjs",
    "release:export": "node tools/exportPublicRelease.mjs",
    "licenses:generate": "node tools/generateThirdPartyNotices.mjs",
    "licenses:check": "node tools/generateThirdPartyNotices.mjs --check",
    "test": "npm run build && node --test dist/**/*.test.js",
    "test:e2e:rollback": "bash scripts/e2e-rollback-regression.sh",
    "test:generated-app": "npm run build && node tools/verifyGeneratedApp.mjs",
    "secrets:generate": "bash scripts/generate-env-secrets.sh .env.generated",
    "secrets:prepare": "bash scripts/prepare-secure-env.sh .env",
    "start": "node dist/web/server.js",
    "start:factory-dashboard": "node dist/factory-dashboard/server.js",
    "cli": "tsx src/cli/index.ts",
    "web": "tsx src/web/server.ts"
  },
  "bin": {
    "itops": "./bin/itops.js"
  },
  "keywords": [
    "ai",
    "agents",
    "it-operations",
    "devops",
    "automation"
  ],
  "author": "Shai Lukov (Right API) <info@right-api.com>",
  "homepage": "https://right-api.com/",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axe-core": "^4.13.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.7",
    "eventemitter3": "^5.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "inquirer": "^12.5.0",
    "ioredis": "^5.10.1",
    "ldapts": "^9.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "ollama": "^0.5.12",
    "openai": "^4.89.0",
    "openid-client": "^6.8.2",
    "ora": "^8.2.0",
    "pg": "^8.20.0",
    "playwright-core": "^1.62.1",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tar-stream": "^3.2.0",
    "undici": "8.10.0",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.8",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
