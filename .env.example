# AI Platform Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
OPENAI_EXPECTED_MODEL=gpt-5
OPENAI_FALLBACK_BASE_URL=
OPENAI_FALLBACK_MODEL=
OPENAI_FALLBACK_EXPECTED_MODEL=
OPENAI_BREAKER_FAILURE_THRESHOLD=3
OPENAI_BREAKER_OPEN_MS=60000
OPENAI_LATENCY_BUDGET_MS=30000
OPENAI_ERROR_RATE_BUDGET=0.20
PROVIDER_HEALTH_PROBE_INTERVAL_MS=300000
OLLAMA_BASE_URL=http://localhost:11434

# Default AI Platform (claude, openai, ollama)
DEFAULT_AI_PLATFORM=openai

# Server Configuration
PORT=19123
HOST=127.0.0.1
WS_PORT=19124

# Separate factory dashboard service
FACTORY_DASHBOARD_PORT=19124
FACTORY_DASHBOARD_HOST=0.0.0.0
CONTROL_API_BASE=http://itops-agents:19123

# Docker Configuration
DOCKER_SOCKET=/var/run/docker.sock

# Organization Configuration
ORG_NAME=IT Ops Team
DEFAULT_WORKSPACE=/data/itops-agents

# Logging
LOG_LEVEL=info
LOG_FILE=/data/itops-agents/logs/itops.log

# Discord alerting (optional)
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_COOLDOWN_MS=900000
DISCORD_ALERT_MIN_SEVERITY=high
OPS_ALERT_ESCALATION_AFTER_MINUTES=30
OPS_ALERT_SWEEP_INTERVAL_MS=300000

# Security
SECRET_KEY=change_this_in_production
JWT_SECRET=change_this_in_production

# Credential Encryption (required in production)
CREDENTIAL_MASTER_KEY=replace_with_long_random_secret_at_least_32_chars
BACKUP_ENCRYPTION_KEY=replace_with_dedicated_backup_key_at_least_32_chars
BACKUP_ENCRYPTION_REQUIRED=true
# Set only when the recovery key is held outside this host (external
# secret manager, offline escrow, or a Docker secret under /run/secrets).
BACKUP_KEY_CUSTODY_EXTERNAL=false
AUTO_REMEDIATION_SERVICE_ALLOWLIST=ssh
# Alternative to BACKUP_ENCRYPTION_KEY: retrieve the key from external
# custody at process startup.
# BACKUP_ENCRYPTION_KEY_CMD=ssh -n root@backup-custodian cat /root/itops-backup-encryption.key
APPROVAL_TOKEN_SECRET=replace_with_long_random_secret_at_least_32_chars
AUTH_TOKEN_SECRET=replace_with_long_random_secret_at_least_32_chars

# User Accounts (set strong passwords in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
VIEWER_USERNAME=
VIEWER_PASSWORD=

# Security Policy
# Set to false for development/testing, true for production
REQUIRE_STRONG_SECRETS=true

# IRC Bridge (agentirc sidecar — connects AgentMessageBus to IRC channels)
IRC_BRIDGE_ENABLED=false
IRC_HOST=agentirc
IRC_PORT=6667
IRC_NICK=itops-bridge

# OpenClaw Bridge (Telegram/OpenClaw channel into agent bus)
OPENCLAW_BRIDGE_ENABLED=false
OPENCLAW_BRIDGE_SECRET=replace_with_bridge_shared_secret
OPENCLAW_BRIDGE_STATE_PATH=/data/itops-agents/openclaw-bridge-state.json

# Multi-server SSH monitoring (src/monitoring/ServerRegistry.ts).
# The local entry is always seeded and uses nsenter. Its display name
# defaults to "local"; override via LOCAL_SERVER_NAME. Remote seeds are
# created only when their host variables are explicitly configured.
SERVER_REGISTRY_DB_PATH=/data/itops-agents/servers.db
LOCAL_SERVER_NAME=local
VPS2_SERVER_HOST=
VPS2_SERVER_USER=root
VPS3_SERVER_HOST=
VPS3_SERVER_USER=root

# Incident escalation pipeline (src/incidents/EscalationPipeline.ts).
# Five levels: L0 new → L1 agent ReAct → L2 auto-remediator → L3 human
# notified via OpenClaw → L4 severity-bumped urgent follow-up + webhook.
# Low-severity incidents skip the pipeline (auto-resolved by stale sweep).
ESCALATION_ENABLED=true
ESCALATION_L3_DELAY_MS=60000        # grace window after L2 before paging a human
ESCALATION_L4_TIMEOUT_MS=1800000    # how long an L3 may sit before L4 promotion
ESCALATION_MIN_SEVERITY=medium      # low | medium | high | critical
# ESCALATION_WEBHOOK_URL=https://pd-bridge.example.com/incidents

# Direct Telegram bot alerting (src/integrations/telegram.ts).
# Sends incident/escalation/resolution notifications straight to a chat
# or group via the Bot API — bypasses OpenClaw. Min severity defaults to
# "high" so low/medium health-monitor noise stays out of chat.
TELEGRAM_ALERT_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456:ABCDEF…
# TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ALERT_MIN_SEVERITY=high

# ─── MCP Clients (ITOps as MCP client) ────────────────────────────────
# Persisted server config lives in JSON on disk (managed via /api/mcp-clients
# and the "MCP Clients" page in the dashboard). Two env shortcuts available:
#
#   MCP_CLIENTS_CONFIG_PATH — override the JSON store location
#   MCP_SERVERS             — JSON array of server defs, applied at boot
#                             when the persisted store doesn't already
#                             contain an entry with the same `id`. Each
#                             entry needs at minimum {id, transport} plus
#                             transport-specific fields (url for http/sse,
#                             command/args for stdio).
#   OPENCLAW_MCP_URL        — convenience: auto-add an OpenClaw HTTP MCP
#                             server using OPENCLAW_GATEWAY_TOKEN above.
#
# Example MCP_SERVERS value (single line, JSON-escaped):
# MCP_SERVERS=[{"id":"openclaw","name":"OpenClaw","transport":"http","url":"http://10.0.0.115:18789/mcp","authToken":"…","exposeToAgents":true}]
MCP_CLIENTS_CONFIG_PATH=/data/itops-agents/mcp-clients.json
# OPENCLAW_MCP_URL=http://10.0.0.115:18789/mcp

# Backup Automation (in-process scheduler)
BACKUP_AUTOMATION_ENABLED=false
BACKUP_AUTOMATION_INTERVAL_MINUTES=60
BACKUP_AUTOMATION_RUN_ON_STARTUP=false
RETENTION_KEEP_LATEST=30
EVENTS_RETENTION_DAYS=90
AI_DECISIONS_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
LIFECYCLE_ARCHIVE_DIR=/data/itops-agents/backups/lifecycle
LIFECYCLE_STATE_PATH=/data/itops-agents/lifecycle-last-run.json

# Full encrypted recovery sets (state + online SQLite snapshots)
RECOVERY_SET_ENABLED=false
RECOVERY_SET_CRON=15 3 * * *
RECOVERY_SET_RETAIN=7
RECOVERY_SET_MAX_AGE_DAYS=14
RECOVERY_RESTORE_ROOT=/data/itops-agents/backups/restore-drills
RECOVERY_STATUS_PATH=/data/itops-agents/backups/recovery-status.json

# Workflow backlog recovery
WORKFLOW_RECOVERY_ENABLED=true
WORKFLOW_ORPHAN_GRACE_MINUTES=60
WORKFLOW_STALE_FAIL_MINUTES=120
WORKFLOW_RECOVERY_INTERVAL_MINUTES=5

# Attributable autonomous incident attempts
AUTONOMY_ATTEMPT_DB_PATH=/data/itops-agents/autonomy-attempts.db
# Must exceed the AutoResolver reopen verification window (24h by default).
AUTONOMY_ATTEMPT_EXPIRY_HOURS=48
RETENTION_MAX_AGE_DAYS=14

# Secret file support (optional): for mounted Docker/Kubernetes secrets, set <KEY>_FILE instead of <KEY>
# Example: CREDENTIAL_MASTER_KEY_FILE=/run/secrets/credential_master_key
# Command-based secret resolution (optional): set <KEY>_CMD to command that prints the secret
# Example: AUTH_TOKEN_SECRET_CMD="vault kv get -field=value secret/itops/auth_token"
# Native Vault provider (optional):
# SECRET_PROVIDER=vault
# SECRET_PROVIDER_VAULT_ADDR=https://vault.example.com
# SECRET_PROVIDER_VAULT_TOKEN=...
# SECRET_PROVIDER_VAULT_PATH=secret/data/itops-agents
# Local file provider (optional, useful for dev/on-prem without Vault):
# SECRET_PROVIDER=file
# SECRET_PROVIDER_FILE_PATH=/data/itops-agents/secret-provider.json
# AWS Secrets Manager provider (optional):
# SECRET_PROVIDER=aws_sm
# SECRET_PROVIDER_AWS_REGION=us-east-1
# SECRET_PROVIDER_AWS_SECRET_ID=itops/agents/secrets
# Optional per-secret mapping:
# AUTH_TOKEN_SECRET_AWS_SECRET_ID=itops/agents/auth
# AUTH_TOKEN_SECRET_AWS_KEY=auth_token_secret
# For plain-string secret payloads (non-JSON), use *_AWS_KEY=value (or "_" / "secret")
# GCP Secret Manager provider (optional):
# SECRET_PROVIDER=gcp_sm
# SECRET_PROVIDER_GCP_PROJECT=my-gcp-project
# SECRET_PROVIDER_GCP_SECRET_ID=itops-agents-secrets
# Optional per-secret mapping:
# AUTH_TOKEN_SECRET_GCP_SECRET_ID=itops-auth
# AUTH_TOKEN_SECRET_GCP_KEY=auth_token_secret
# For plain-string secret payloads (non-JSON), use *_GCP_KEY=value (or "_" / "secret")
# Azure Key Vault provider (optional):
# SECRET_PROVIDER=azure_kv
# SECRET_PROVIDER_AZURE_VAULT_NAME=itops-secrets-kv
# SECRET_PROVIDER_AZURE_SECRET_NAME=itops-agents-secrets
# Optional per-secret mapping:
# AUTH_TOKEN_SECRET_AZURE_SECRET_NAME=itops-auth
# AUTH_TOKEN_SECRET_AZURE_KEY=auth_token_secret
# For plain-string secret payloads (non-JSON), use *_AZURE_KEY=value (or "_" / "secret")
# Optional per-secret key mapping in provider payload:
# AUTH_TOKEN_SECRET_PROVIDER_KEY=auth_token_secret
# Optional per-secret override:
# AUTH_TOKEN_SECRET_VAULT_PATH=secret/data/itops-auth
# AUTH_TOKEN_SECRET_VAULT_KEY=auth_token_secret

# Privileged/destructive execution target allowlist (comma-separated).
# When set, privileged/destructive tool runs are blocked unless params contain allowlisted target(s).
PRIVILEGED_TARGET_ALLOWLIST=
# Optional policy store path for API-managed allowlist policy
TARGET_ALLOWLIST_POLICY_PATH=/data/itops-agents/target-allowlist-policy.json

# Credential anomaly detection thresholds (for /api/alerts signal)
CREDENTIAL_ANOMALY_WINDOW_MINUTES=60
CREDENTIAL_ANOMALY_MAX_USES=10
# Optional enforcement mode: block risky commands when hot credentials are detected
CREDENTIAL_ANOMALY_ENFORCE_BLOCK=false
CREDENTIAL_ANOMALY_BLOCK_FACTOR=1.5
CREDENTIAL_ANOMALY_BLOCK_RISKS=privileged,destructive

# Orchestrator reliability controls
ORCHESTRATOR_AUTO_RECOVER=true
ORCHESTRATOR_STUCK_THRESHOLD_MINUTES=90
ORCHESTRATOR_STUCK_RETRY_LIMIT=2
ORCHESTRATOR_STUCK_RETRY_COOLDOWN_MINUTES=15
# Orchestrator auto-sweep heartbeat (ms, default 60000)
ORCHESTRATOR_SWEEP_INTERVAL_MS=60000
# Agent health threshold (minutes before agent is considered idle/stuck, default 30)
AGENT_STUCK_THRESHOLD_MINUTES=30
# IRC supervisor: periodic stuck-task alert interval (ms, default 300000 = 5 min)
IRC_SUPERVISOR_CHECK_INTERVAL_MS=300000
# IRC supervisor: hourly health digest interval (ms, default 3600000 = 1 hour)
IRC_SUPERVISOR_HEALTH_INTERVAL_MS=3600000
# IRC supervisor: task idle threshold before #alerts post (ms, default 900000 = 15 min)
IRC_SUPERVISOR_STUCK_THRESHOLD_MS=900000
ORCHESTRATOR_RELIABILITY_POLICY_PATH=/data/itops-agents/orchestrator-reliability-policy.json
# Orchestrator reliability SLO monitoring window/thresholds
ORCHESTRATOR_SLO_WINDOW_MINUTES=60
ORCHESTRATOR_SLO_MAX_QUARANTINED=1
ORCHESTRATOR_SLO_MAX_RECOVERY_FAILED=0
ORCHESTRATOR_SLO_MIN_SUCCESS_RATE=0.9

# S3 Off-Host Backups (optional — works with AWS S3, Cloudflare R2, MinIO, etc.)
# BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
# BACKUP_S3_BUCKET=my-itops-agents-backups
# BACKUP_S3_ACCESS_KEY=your_access_key_id
# BACKUP_S3_SECRET_KEY=your_secret_access_key
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_RETAIN=30

# Optional typed application-builder project registry.
BUILDER_DB_PATH=/data/itops-agents/builder.db
PREVIEW_MAX_PER_TENANT=3
PREVIEW_MAX_GLOBAL=10
PREVIEW_TTL_MINUTES=30
PREVIEW_MAX_TTL_MINUTES=60
BUILDER_GATE_SIGNING_KEY=
BUILDER_GATE_MAX_CONCURRENT=2
CHROMIUM_PATH=/usr/bin/chromium-browser
BUILDER_RELEASE_SIGNING_KEY=
BUILDER_RELEASE_REPO=/data/itops-agents/builder-releases
BUILDER_INTEGRATION_SIGNING_KEY=
BUILDER_LAUNCH_TTL_MINUTES=480
# Dedicated AES-256-GCM key for plugin and managed-connection credentials.
PLUGIN_ENCRYPTION_KEY=

# HTTPS / Reverse Proxy
# Set to the HTTPS URL Caddy exposes RightAPI Forge on (used for CORS allowlist).
# The env var name is kept as BEACON_HTTPS_URL for backward compatibility.
BEACON_HTTPS_URL=https://itops.example.com
